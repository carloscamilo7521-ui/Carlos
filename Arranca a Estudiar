<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mi método de estudio</title>
<style>
:root{--bg:#f6f4ef;--card:#fff;--tx:#1f2430;--mut:#5d6575;--ac:#3b5bdb;--ac2:#e8edff;--bd:#e0dccf;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#15171d;--card:#1f232c;--tx:#eceef3;--mut:#9aa3b5;--ac:#8fa6ff;--ac2:#262d45;--bd:#323848;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#15171d;--card:#1f232c;--tx:#eceef3;--mut:#9aa3b5;--ac:#8fa6ff;--ac2:#262d45;--bd:#323848;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Georgia,"Times New Roman",serif;line-height:1.55}
main{max-width:760px;margin:0 auto;padding:24px 16px 48px}
h1{font-size:2rem;margin:.2em 0}h2{font-size:1.2rem;margin:0 0 .6em}
p.sub{color:var(--mut);margin-top:0}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px;margin:16px 0}
label{display:block;font-family:system-ui,sans-serif;font-size:.85rem;color:var(--mut);margin:12px 0 4px}
input,select{width:100%;padding:10px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);font-size:1rem}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:520px){.row{grid-template-columns:1fr}}
button{font-family:system-ui,sans-serif;background:var(--ac);color:#fff;border:0;border-radius:10px;padding:11px 18px;font-size:1rem;cursor:pointer;margin:12px 8px 0 0}
button.alt{background:var(--ac2);color:var(--ac)}
[hidden]{display:none!important}
.phase{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--bd)}
.phase:last-child{border:0}
.min{font-family:system-ui,sans-serif;font-weight:700;color:var(--ac);min-width:54px}
.phase b{display:block}.phase span{color:var(--mut);font-size:.95rem}
.tags{display:flex;flex-wrap:wrap;gap:8px}
.tag{background:var(--ac2);color:var(--ac);padding:5px 12px;border-radius:99px;font-family:system-ui,sans-serif;font-size:.85rem}
#clock{font-family:system-ui,sans-serif;font-size:3.4rem;font-weight:700;text-align:center;font-variant-numeric:tabular-nums}
#cur{text-align:center;color:var(--mut)}
.bar{height:8px;background:var(--ac2);border-radius:9px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--ac);transition:width .5s}
</style>
</head>
<body>
<main>
<h1>📚 Crea tu método de estudio</h1>
<p class="sub">Cuéntame qué necesitas y te preparo una sesión, un calendario de repasos y un temporizador.</p>

<div class="card" id="form">
<label for="mat">Materia o tema</label>
<input id="mat" placeholder="Ej.: Historia de España, siglo XIX">
<div class="row">
<div><label for="obj">¿Qué necesitas lograr?</label>
<select id="obj"><option value="mem">Memorizar datos</option><option value="com">Comprender conceptos</option><option value="pra">Practicar problemas</option></select></div>
<div><label for="niv">Tu nivel actual</label>
<select id="niv"><option value="1">Empiezo de cero</option><option value="2" selected>Sé algo</option><option value="3">Repaso final</option></select></div>
<div><label for="tie">Tiempo por sesión (min)</label>
<select id="tie"><option>30</option><option selected>45</option><option>60</option><option>90</option><option>120</option></select></div>
<div><label for="dia">Días hasta el examen</label>
<input id="dia" type="number" min="1" max="120" value="10"></div>
</div>
<button id="go">Crear mi método</button>
</div>

<div id="out" hidden>
<div class="card"><h2 id="tit"></h2><p id="desc"></p><div class="tags" id="tags"></div></div>
<div class="card"><h2>Tu sesión de estudio</h2><div id="phases"></div></div>
<div class="card"><h2>Calendario de repasos</h2><p id="cal" style="margin:0"></p></div>
<div class="card"><h2>⏱ Temporizador guiado</h2>
<div id="cur">Pulsa iniciar para empezar la fase 1</div><div id="clock">00:00</div>
<div class="bar"><i id="pb"></i></div>
<div style="text-align:center"><button id="st">Iniciar</button><button class="alt" id="nx">Siguiente fase</button></div></div>
<div class="card"><h2>Consejos para esta sesión</h2><ul id="tips" style="margin:0;padding-left:20px"></ul></div>
</div>
</main>
<script>
const $=id=>document.getElementById(id);
const M={
mem:{n:"Recuperación activa + repetición espaciada",d:"Para memorizar, lo que más funciona es intentar recordar sin mirar y repasar justo cuando empiezas a olvidar.",
act:["Crea tarjetas pregunta/respuesta","Cúbrelas y responde en voz alta, sin mirar"],tags:["Flashcards","Mnemotecnias","Repasos espaciados"],
tips:["Escribe preguntas, no solo resúmenes.","Separa las tarjetas que fallas y repásalas más a menudo.","Duerme bien: la memoria se consolida mientras duermes."]},
com:{n:"Técnica Feynman + mapas conceptuales",d:"Para comprender, explica el tema con palabras sencillas como si enseñaras a alguien y detecta dónde te atascas.",
act:["Lee y subraya solo las ideas clave","Explica el tema en voz alta con tus palabras"],tags:["Feynman","Mapa conceptual","Preguntas «¿por qué?»"],
tips:["Si no puedes explicarlo fácil, aún no lo dominas.","Relaciona cada idea nueva con algo que ya sabes.","Dibuja esquemas con flechas de causa y efecto."]},
pra:{n:"Práctica deliberada + análisis de errores",d:"Para practicar, resuelve ejercicios sin ayuda y dedica tiempo a entender por qué te equivocas.",
act:["Resuelve un ejercicio sin mirar la teoría","Anota en un cuaderno de errores qué falló y por qué"],tags:["Ejercicios","Cuaderno de errores","Exámenes antiguos"],
tips:["Cronometra algunos ejercicios como en el examen.","Repite los que fallaste a los 2-3 días.","Primero intenta, luego mira la solución."]}};
let phases=[],idx=0,left=0,tot=0,t=null;
function build(){
const o=$("obj").value,niv=+$("niv").value,T=+$("tie").value,D=Math.max(1,+$("dia").value||1),m=M[o];
const pre=niv==1?.15:.1,est=niv==1?.5:.4,test=niv==3?.35:.25;
const r=x=>Math.max(1,Math.round(T*x));
const a=r(pre),b=r(est),c=r(test),e=Math.max(1,T-a-b-c);
phases=[
{m:a,t:"Calentamiento",d:"Repasa de memoria lo de la sesión anterior y fija un objetivo claro para hoy."},
{m:b,t:"Estudio activo",d:m.act[0]+"."},
{m:c,t:"Autotest",d:m.act[1]+"."},
{m:e,t:"Cierre y descanso",d:"Resume en 3 líneas lo aprendido, anota dudas y haz una pausa real lejos del móvil."}];
$("tit").textContent=($("mat").value.trim()?$("mat").value.trim()+": ":"")+m.n;
$("desc").textContent=m.d;
$("tags").innerHTML=m.tags.map(x=>`<span class="tag">${x}</span>`).join("");
$("phases").innerHTML=phases.map(p=>`<div class="phase"><div class="min">${p.m} min</div><div><b>${p.t}</b><span>${p.d}</span></div></div>`).join("");
const ds=[...new Set([0,1,3,7,14,21].filter(x=>x<D))];
if(D>1&&!ds.includes(D-1))ds.push(D-1);
$("cal").innerHTML=D<=1?"Solo tienes hoy: haz la sesión completa y repasa tus fallos al final.":
"Sesiones en los días: "+ds.map(x=>`<span class="tag">día ${x+1}</span>`).join(" ")+"<br><br>El último repaso va el día antes del examen, ligero y sin estudiar nada nuevo.";
$("tips").innerHTML=m.tips.concat(["Móvil en otra habitación durante el estudio activo."]).map(x=>`<li>${x}</li>`).join("");
$("out").hidden=false;reset();$("out").scrollIntoView({behavior:"smooth"});}
function fmt(s){return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")}
function show(){$("clock").textContent=fmt(left);$("pb").style.width=(tot?100*(tot-left)/tot:0)+"%"}
function load(i){idx=i;tot=left=phases[i].m*60;$("cur").textContent=`Fase ${i+1}/${phases.length}: ${phases[i].t}`;show()}
function reset(){clearInterval(t);t=null;$("st").textContent="Iniciar";load(0);$("cur").textContent="Pulsa iniciar para empezar la fase 1"}
function tick(){left--;if(left<=0){if(idx<phases.length-1){load(idx+1)}else{clearInterval(t);t=null;$("cur").textContent="🎉 ¡Sesión completada!";left=0;$("st").textContent="Reiniciar"}}show()}
$("st").onclick=()=>{
if($("st").textContent=="Reiniciar"){reset();return}
if(t){clearInterval(t);t=null;$("st").textContent="Continuar"}
else{if($("cur").textContent.startsWith("Pulsa"))load(0);t=setInterval(tick,1000);$("st").textContent="Pausar"}};
$("nx").onclick=()=>{if(idx<phases.length-1){load(idx+1)}};
$("go").onclick=build;
</script>
</body>
</html>
